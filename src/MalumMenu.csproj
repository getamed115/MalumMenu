<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DebugType>embedded</DebugType>

        <VersionPrefix>3.2.0</VersionPrefix>
        <Description>all play and no cheats makes among us a dull game</Description>
        <Authors>scp222thj, astra1dev</Authors>
        <Platforms>AnyCPU;x86</Platforms>
    </PropertyGroup>

    <!--<ItemGroup>
        <EmbeddedResource Include=".\Assets\**" />
    </ItemGroup>-->

	<ItemGroup>
		<PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.735" Private="false" ExcludeAssets="runtime;native" />
		<PackageReference Include="AmongUs.GameLibs.Steam" Version="2026.8.18" PrivateAssets="all" />

		<PackageReference Include="BepInEx.AutoPlugin" Version="1.1.0" PrivateAssets="all" />
		<PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>


	<PropertyGroup>
		<AmongUs>C:\Program Files (x86)\Steam\steamapps\common\Among Us</AmongUs>
	</PropertyGroup>

	<Target Name="CopyAndCompare" AfterTargets="Build" Condition="'$(AmongUs)' != ''">
		<PropertyGroup>
			<PluginDestination>$([System.IO.Path]::GetFullPath('$(AmongUs)/BepInEx/plugins/'))</PluginDestination>
			<SizeRecordFile>$(TargetDir)last_build_size.txt</SizeRecordFile>
		</PropertyGroup>

		<Exec Command="powershell -NoProfile -Command &quot;$old = if (Test-Path '$(SizeRecordFile)') { [long](Get-Content '$(SizeRecordFile)' -Raw) } else { 0 }; $new = (Get-Item '$(TargetPath)').Length; $diff = $new - $old; $sign = if ($diff -ge 0) { '+' } else { '' }; Write-Host ('[BUILD] DLL Size: {0:N2} KB ({1}{2:N2} KB change)' -f ($new / 1KB), $sign, ($diff / 1KB)) -ForegroundColor Cyan&quot;" />

		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDestination)" UseSymboliclinksIfPossible="true" />
		<Message Text="[BUILD] Successfully copied $(TargetFileName) to $(PluginDestination)" Importance="high" />
	</Target>

	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
	  <Exec Command="powershell -Command &quot;if (Test-Path '$(TargetPath)') { (Get-Item '$(TargetPath)').Length | Out-File '$(TargetDir)last_build_size.txt' -Encoding ascii } else { '0' | Out-File '$(TargetDir)last_build_size.txt' -Encoding ascii }&quot;" />
	</Target>
</Project>
